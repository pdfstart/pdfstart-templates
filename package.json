{
  "name": "pdfstart-templates",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Turn what you write into a polished PDF you can send as-is.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @pdfstart/report run build",
    "demo": "pnpm --filter @pdfstart/report run demo",
    "report": "pnpm --filter @pdfstart/report run report"
  }
}
